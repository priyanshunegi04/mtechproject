APP_ENV=production
PORT=10000
LOG_LEVEL=INFO
WORKERS=2
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thapar_elective_ai?retryWrites=true&w=majority&appName=ThaparElectiveAI
MONGODB_DB_NAME=thapar_elective_ai
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
ML_SERVICE_API_KEY=replace_with_internal_ml_service_shared_secret_key_32_chars
ALLOWED_ORIGINS=https://thapar-elective-backend.onrender.com,https://electives.thapar.edu,https://thapar-elective-ai.vercel.app
MODEL_REGISTRY_COLLECTION=ml_model_registry
AUTO_TRAIN_ON_STARTUP=true
RANDOM_SEED=42
