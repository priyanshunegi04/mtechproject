{
  "name": "@thapar-elective-ai/backend",
  "version": "1.0.0",
  "private": true,
  "description": "ThaparElectiveAI Enterprise Cloud REST API — Node.js + Express + TypeScript + MongoDB Atlas + Managed Redis",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
