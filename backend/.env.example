NODE_ENV=production
PORT=8080
LOG_LEVEL=info
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/thapar_elective_ai?retryWrites=true&w=majority&appName=ThaparElectiveAI
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_HEARTBEAT_FREQUENCY_MS=10000
JWT_ACCESS_SECRET=replace_with_64_char_cryptographic_access_secret_for_thapar_edu
JWT_REFRESH_SECRET=replace_with_64_char_cryptographic_refresh_secret_for_thapar_edu
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
ALLOWED_INSTITUTIONAL_DOMAIN=thapar.edu
ML_SERVICE_URL=https://thapar-elective-ml.onrender.com
ML_SERVICE_API_KEY=replace_with_internal_ml_service_shared_secret_key_32_chars
ML_SERVICE_TIMEOUT_MS=60000
FRONTEND_ORIGIN=https://mtechproject.vercel.app,https://electives.thapar.edu,https://thapar-elective-ai.vercel.app
REDIS_URL=rediss://default:<password>@<managed-redis-host>:6379
REDIS_CACHE_TTL_SECONDS=900
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=30
RECOMMENDATION_RATE_LIMIT_MAX_REQUESTS=150
