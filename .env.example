# ============================================================================
# ThaparElectiveAI Monorepo — Root Production Cloud Environment Template
# Used by docker-compose.prod.yml and CI/CD pipelines
# ============================================================================

# Remote MongoDB Atlas Cluster (MUST use mongodb+srv://)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@tiet-elective-cluster.abcde.mongodb.net/thapar_elective_ai?retryWrites=true&w=majority&appName=ThaparElectiveAI
MONGODB_DB_NAME=thapar_elective_ai

# Remote Managed Redis Cluster (Upstash / Redis Cloud using rediss:// TLS)
REDIS_URL=rediss://default:<redis_password>@apn1-tiet-cache.upstash.io:6379
REDIS_CACHE_TTL_SECONDS=900

# Microservice Communication & Shared Secret
ML_SERVICE_URL=https://thapar-elective-ml.onrender.com
ML_SERVICE_API_KEY=<generate_with_openssl_rand_hex_32>

# Institutional JWT Authentication (@thapar.edu)
JWT_ACCESS_SECRET=<generate_with_openssl_rand_hex_32>
JWT_REFRESH_SECRET=<generate_with_openssl_rand_hex_32>
ALLOWED_INSTITUTIONAL_DOMAIN=thapar.edu

# Public Cloud Endpoints & CORS Allowlist
VITE_API_BASE_URL=https://thapar-elective-backend.onrender.com/api/v1
CORS_ALLOWED_ORIGINS=https://electives.thapar.edu,https://mtechproject.vercel.app

